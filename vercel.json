{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "includeFiles": "backend/**,public/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__vercel_path=/api/$1"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__vercel_path=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__vercel_path=/openapi.json"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py?__vercel_path=/redoc"
    }
  ]
}
